#!/bin/bash
# Test VM bootstrap: Docker + policy routing so that traffic sourced from the workload (data) ENI goes through
# the Transit Gateway and the firewall, while SSH and image pulls keep using the management ENI.
set -euxo pipefail
exec > >(tee /var/log/testkit-bootstrap.log) 2>&1
RT_TABLE=100
export DEBIAN_FRONTEND=noninteractive

apt-get update -y
apt-get install -y docker.io curl iproute2 python3
systemctl enable --now docker

# Wait for the secondary (data) ENI
for i in $(seq 1 30); do
  [ "$(ip -o link show | awk -F': ' '$2 !~ /^(lo|docker)/ {print $2}' | wc -l)" -ge 2 ] && break; sleep 2
done
TOKEN=$(curl -sS -X PUT "http://169.254.169.254/latest/api/token" -H "X-aws-ec2-metadata-token-ttl-seconds: 300")
MGMT_MAC=$(curl -sS -H "X-aws-ec2-metadata-token: $TOKEN" http://169.254.169.254/latest/meta-data/mac)
MGMT_IFACE=$(grep -l -i "$MGMT_MAC" /sys/class/net/*/address 2>/dev/null | head -n1 | awk -F/ '{print $5}')
[ -n "$MGMT_IFACE" ] || MGMT_IFACE=$(ip -o -4 route show default | head -n1 | awk '{print $5}')
DATA_IFACE=$(ip -o link show | awk -F': ' '$2 !~ /^(lo|docker)/ {print $2}' | grep -v "^$${MGMT_IFACE}$" | head -n1)
DATA_IP=$(ip -o -4 addr show dev "$${DATA_IFACE}" | awk '{print $4}' | cut -d/ -f1)
DATA_MAC=$(cat /sys/class/net/$${DATA_IFACE}/address)
DATA_NET=$(curl -sS -H "X-aws-ec2-metadata-token: $TOKEN" "http://169.254.169.254/latest/meta-data/network/interfaces/macs/$${DATA_MAC}/subnet-ipv4-cidr-block")
DATA_GW=$(python3 -c 'import ipaddress,sys; print(ipaddress.ip_network(sys.argv[1])[1])' "$${DATA_NET}")

# Main table: internal ranges via the data ENI. Table 100: default via the data ENI for traffic sourced from the data IP.
cat > /etc/netplan/99-data-route.yaml <<NP
network:
  version: 2
  ethernets:
    $${DATA_IFACE}:
      routes:
        - to: ${internal_cidr}
          via: $${DATA_GW}
        - to: $${DATA_NET}
          scope: link
          table: $${RT_TABLE}
        - to: 0.0.0.0/0
          via: $${DATA_GW}
          table: $${RT_TABLE}
      routing-policy:
        - from: $${DATA_IP}
          table: $${RT_TABLE}
          priority: 100
NP
chmod 600 /etc/netplan/99-data-route.yaml
netplan apply || true
for i in $(seq 1 10); do ip -o route show dev "$${DATA_IFACE}" | grep -q "^$${DATA_NET}" && break; sleep 1; done
ip route show ${internal_cidr} dev "$${DATA_IFACE}" | grep -q . || ip route replace ${internal_cidr} via "$${DATA_GW}" dev "$${DATA_IFACE}"
ip route show table "$${RT_TABLE}" | grep -q "^$${DATA_NET}" || ip route replace "$${DATA_NET}" dev "$${DATA_IFACE}" scope link table "$${RT_TABLE}"
ip route show table "$${RT_TABLE}" | grep -q '^default' || ip route replace default via "$${DATA_GW}" dev "$${DATA_IFACE}" table "$${RT_TABLE}"
ip rule show | grep -q "from $${DATA_IP} lookup $${RT_TABLE}" || ip rule add from "$${DATA_IP}" table "$${RT_TABLE}" priority 100

# Pre-pull the testkit image (deploy/up.sh starts the containers once certificates are in place)
docker pull ${image} || true
echo "$${DATA_IP}" > /etc/testkit-data-ip
touch /var/lib/testkit-bootstrap-done
