# Name of this VM's environment (must match an environment in the portal Settings)
TESTKIT_ENV=pre
# Workload IP of this VM (source of the tests). Empty = the one routed towards SERVER_IP
SRC_IP=
# Test server workload IP
SERVER_IP=10.3.0.6
# Portal: 1 only on the main server. Clients reach it over the data plane (HTTP must be allowed to the server)
PORTAL=1
PORTAL_URL=http://10.3.0.6/portal
# Optional: image to use (default ghcr.io/gdiaz777/cloud-firewall-testkit:latest)
# TESTKIT_IMAGE=cloud-firewall-testkit:local
