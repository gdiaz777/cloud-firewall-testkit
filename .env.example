# Copy to .env next to docker-compose.yml (optional: everything can also be passed on the command line)
# Client: test server IP (required on clients)
SERVER=10.3.0.6
# Client: environment name shown in the portal (default: host name)
TESTKIT_ENV=
# Client: source IP for the tests (default: the IP routed towards SERVER)
SRC_IP=
# Server: IP to publish if auto-detection picks the wrong interface
SERVER_IP=
# Image (default ghcr.io/gdiaz777/cloud-firewall-testkit:latest)
# TESTKIT_IMAGE=cloud-firewall-testkit:local
